# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Local config / secrets
config.yaml
.env

# Generated media & per-video work
projects/
work/
*.mp4
*.wav
*.m4a

# Footage/music libraries (keep folders, ignore contents)
assets/footage/*
assets/music/*
!assets/**/.gitkeep
# keep the curated sources guide + bundled fonts in the repo
!assets/music/SOURCES.md
# downloaded TTS voice models (re-fetched by setup)
assets/voices/

# Node / Electron deps (bundled Electron is ~250 MB)
node_modules/

# OS cruft, logs, local tooling/scratch
.DS_Store
*.log
.claude/
auditions/

# Built app bundles (generated; live in electron/dist/, also ignored)
AUT Video Pipeline.app/
Social AstroStacker App.app/

# keep the Electron app icon (build resource) even though build/ is ignored
!electron/build/
!electron/build/icon.icns
vendor/
