{
  "name": "tiktok-ai-suite",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.stefano.tiktokai",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/",
      "app/",
      "assets/",
      "output/",
      "offline_bundle/",
      ".env"
    ]
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "fs-extra": "^11.1.1",
    "archiver": "^5.3.1",
    "cross-spawn": "^7.0.3"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0"
  }
}
