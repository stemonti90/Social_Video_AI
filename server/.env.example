# Copy to .env (gitignored) and fill in. deploy.sh generates CONTROL_TOKEN for you.
CONTROL_TOKEN=change-me-to-a-long-random-secret
# From Postiz → Settings → Developers. Leave empty until the server Postiz account exists; the service
# still runs and keeps rendered videos (posted_to=[]) until a token + connected channel are present.
POSTIZ_TOKEN=
